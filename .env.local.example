NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used to build links back into the app (email confirmation redirect, and
# the "View Dashboard" link in the daily digest email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. From Supabase Project Settings -> API -> service_role key.
# NEVER prefix this with NEXT_PUBLIC_ or expose it to the browser — it
# bypasses row-level security entirely. Only used by the daily digest cron
# route to read across all users and look up their email addresses.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From https://resend.com (free tier: 100 emails/day, no card required).
# Used to send the daily digest email.
RESEND_API_KEY=your-resend-api-key

# The "from" address for the digest email. Resend's shared sandbox address
# (onboarding@resend.dev) only delivers to the email you signed up to Resend
# with — fine for testing solo, but verify your own domain in Resend before
# sending to real contractors.
EMAIL_FROM="GripBill <onboarding@resend.dev>"

# A random secret shared with Vercel Cron so only it can trigger the daily
# digest endpoint. Generate one with `openssl rand -hex 32`.
CRON_SECRET=your-random-secret
